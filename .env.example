# ==============================================================================
# AIRE Environment Configuration Baseline
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_PORT=4000
VITE_API_URL=http://localhost:4000/api/v1

# PostgreSQL Database Configuration
# Local host port maps to 5433 to prevent collision with any existing host postgres service
DB_HOST=localhost
DB_PORT=5433
DB_USER=aire_user
DB_PASSWORD=aire_secure_dev_password
DB_NAME=aire_db
DATABASE_URL=postgresql://aire_user:aire_secure_dev_password@localhost:5433/aire_db?schema=public

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO / Object Storage Configuration
MINIO_ROOT_USER=aire_minio_admin
MINIO_ROOT_PASSWORD=aire_minio_secret_key
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=aire-evidence

# Security and Logging
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=development_jwt_secret_change_in_production_min_32_chars
BETTER_AUTH_SECRET=development_better_auth_secret_minimum_32_characters_long_for_dev
BETTER_AUTH_URL=http://localhost:4000
APP_DATABASE_URL=postgresql://aire_app_user:aire_app_secure_dev_password@localhost:5433/aire_db?schema=public

