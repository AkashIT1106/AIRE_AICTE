// AIRE Platform Database Schema
// Phase 1 + Phase 2 (Identity, Access, Tenant Isolation & Audit)
// Specifications: PROJECT_PLAN.md Sections 11.4, 12.2, 12.3, 16, 17, 19

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Phase 1: Operational Baseline Models
// -----------------------------------------------------------------------------

/// Baseline operational health probe tracking table
model SystemHealthCheck {
  id        String   @id @default(uuid())
  probeName String   @map("probe_name")
  status    String
  metadata  Json?
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("system_health_checks")
}

/// Baseline audit event table per Section 12.3 and 39.1
model AuditEventBaseline {
  id            String   @id @default(uuid())
  timestamp     DateTime @default(now())
  severity      String   @default("info")
  service       String
  correlationId String   @map("correlation_id")
  actorId       String?  @map("actor_id")
  resourceType  String   @map("resource_type")
  resourceId    String?  @map("resource_id")
  eventType     String   @map("event_type")
  outcome       String
  metadata      Json?

  @@index([correlationId])
  @@index([timestamp])
  @@map("audit_events_baseline")
}

/// Transactional outbox event table per Section 11.4 and 12.3
model OutboxEvent {
  id            String    @id @default(uuid())
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  correlationId String    @map("correlation_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")
  status        String    @default("PENDING")

  @@index([status, createdAt])
  @@map("outbox_events")
}

// -----------------------------------------------------------------------------
// Phase 2: Better Auth Core Models
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions      Session[]
  accounts      Account[]
  memberships   InstitutionMember[]
  platformRoles PlatformUserRole[]
  authoredPolicies  PolicyPack[]              @relation("PolicyAuthor")
  reviewedSignoffs  PolicyActivationSignoff[] @relation("PolicySignoffReviewer")

  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

// -----------------------------------------------------------------------------
// Phase 2: AIRE Multi-Tenant Authorization & Records
// -----------------------------------------------------------------------------

model Institution {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  aicteId   String?  @unique @map("aicte_id")
  legalName String?  @map("legal_name")
  address   String?
  state     String?
  district  String?
  pincode   String?
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED, INACTIVE
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members          InstitutionMember[]
  records          InstitutionRecord[]
  campuses         Campus[]
  approvalOrders   ApprovalOrder[]
  programmeAliases ProgrammeAlias[]

  @@map("institutions")
}

/// Physical campus under an institution
model Campus {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  code          String
  name          String
  address       String?
  state         String?
  district      String?
  pincode       String?
  status        String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution      Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  seatEntitlements SeatEntitlement[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("campuses")
}

/// Canonical AICTE academic programme catalog
model Programme {
  id            String   @id @default(uuid())
  canonicalCode String   @unique @map("canonical_code")
  name          String
  degreeLevel   String   @map("degree_level") // UG, PG, DIPLOMA, POST_DIPLOMA
  discipline    String
  durationYears Int      @default(4) @map("duration_years")
  status        String   @default("ACTIVE") // ACTIVE, DISCONTINUED
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  aliases          ProgrammeAlias[]
  seatEntitlements SeatEntitlement[]

  @@index([degreeLevel])
  @@index([discipline])
  @@map("programmes")
}

/// Programme aliases for normalisation of variants
model ProgrammeAlias {
  id              String   @id @default(uuid())
  programmeId     String   @map("programme_id")
  rawTitle        String   @map("raw_title")
  normalisedTitle String   @map("normalised_title")
  institutionId   String?  @map("institution_id")
  confidence      Float    @default(1.0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  programme   Programme    @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([normalisedTitle, institutionId])
  @@index([normalisedTitle])
  @@index([programmeId])
  @@map("programme_aliases")
}

/// Annual AICTE Approval Orders (EOA / LOA)
model ApprovalOrder {
  id             String    @id @default(uuid())
  institutionId  String    @map("institution_id")
  academicYear   String    @map("academic_year")
  orderNumber    String    @unique @map("order_number")
  orderType      String    @default("EOA") @map("order_type") // EOA, LOA
  issueDate      DateTime  @default(now()) @map("issue_date")
  status         String    @default("ACTIVE") // DRAFT, ACTIVE, SUPERSEDED
  supersededById String?   @map("superseded_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  institution  Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  supersededBy ApprovalOrder?    @relation("OrderSupersession", fields: [supersededById], references: [id])
  supersedes   ApprovalOrder[]   @relation("OrderSupersession")
  entitlements SeatEntitlement[]

  @@index([institutionId, academicYear])
  @@index([status])
  @@map("approval_orders")
}

/// Programme-level sanctioned intake and category quotas
model SeatEntitlement {
  id                 String   @id @default(uuid())
  approvalOrderId    String   @map("approval_order_id")
  programmeId        String   @map("programme_id")
  campusId           String?  @map("campus_id")
  sanctionedIntake   Int      @map("sanctioned_intake")
  openSeats          Int      @default(0) @map("open_seats")
  scSeats            Int      @default(0) @map("sc_seats")
  stSeats            Int      @default(0) @map("st_seats")
  obcSeats           Int      @default(0) @map("obc_seats")
  ewsSeats           Int      @default(0) @map("ews_seats")
  tfwSeats           Int      @default(0) @map("tfw_seats")
  supernumerarySeats Int      @default(0) @map("supernumerary_seats")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  approvalOrder ApprovalOrder @relation(fields: [approvalOrderId], references: [id], onDelete: Cascade)
  programme     Programme     @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  campus        Campus?       @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([approvalOrderId, programmeId, campusId])
  @@index([approvalOrderId])
  @@index([programmeId])
  @@map("seat_entitlements")
}

model InstitutionMember {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  userId        String   @map("user_id")
  role          String   @default("INSTITUTION_OPERATOR") // INSTITUTION_ADMIN, INSTITUTION_OPERATOR
  status        String   @default("ACTIVE") // ACTIVE, INACTIVE, REVOKED
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([institutionId, userId])
  @@index([userId, status])
  @@index([institutionId, status])
  @@map("institution_members")
}

model PlatformUserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  role      String   // SUPER_ADMIN, AICTE_ADMIN, AICTE_REVIEWER, AUDITOR
  status    String   @default("ACTIVE") // ACTIVE, REVOKED
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId, status])
  @@map("platform_user_roles")
}

/// Tenant-scoped entity protected by PostgreSQL Row-Level Security (RLS)
model InstitutionRecord {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  title         String
  payload       Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@map("institution_records")
}

/// Comprehensive Phase 2 Audit Event Table
model AuditEvent {
  id            String   @id @default(uuid())
  timestamp     DateTime @default(now())
  severity      String   @default("info") // info, warn, error
  service       String   @default("aire-server")
  correlationId String   @map("correlation_id")
  actorId       String?  @map("actor_id")
  tenantId      String?  @map("tenant_id")
  action        String
  resourceType  String   @map("resource_type")
  resourceId    String?  @map("resource_id")
  status        String   // SUCCESS, FAILURE, DENIED
  metadata      Json?

  @@index([correlationId])
  @@index([tenantId])
  @@index([timestamp])
  @@map("audit_events")
}

// -----------------------------------------------------------------------------
// Phase 4: Regulatory Policy Registry & Rule Engine (Module M04)
// -----------------------------------------------------------------------------

/// Regulatory Policy Pack representing an AICTE Approval Process Handbook (APH) edition
model PolicyPack {
  id               String    @id @default(uuid())
  code             String    @unique // e.g. "AICTE-APH-2026-27-V1.0"
  name             String    // e.g. "AICTE Approval Process Handbook 2026-27"
  academicYear     String    @map("academic_year") // e.g. "2026-27"
  edition          String    @default("1.0")
  status           String    @default("DRAFT") // DRAFT, COUNCIL_REVIEW, GAZETTE_NOTIFIED, IN_FORCE, SUPERSEDED, AMENDED
  stateCode        String?   @map("state_code") // null for National AICTE norms, or state code (e.g., "MH", "TN")
  gazetteReference String?   @map("gazette_reference") // Official Gazette notification number
  contentHash      String?   @map("content_hash") // SHA-256 hash of rules & parameters
  authorId         String    @map("author_id")
  effectiveFrom    DateTime? @map("effective_from")
  effectiveTo      DateTime? @map("effective_to")
  supersededById   String?   @map("superseded_by_id")
  parentPackId     String?   @map("parent_pack_id") // For AMENDED corrigenda packs
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  author           User                      @relation("PolicyAuthor", fields: [authorId], references: [id])
  supersededBy     PolicyPack?               @relation("PolicyPackSupersession", fields: [supersededById], references: [id])
  supersedes       PolicyPack[]              @relation("PolicyPackSupersession")
  parentPack       PolicyPack?               @relation("PolicyPackAmendments", fields: [parentPackId], references: [id])
  amendments       PolicyPack[]              @relation("PolicyPackAmendments")
  rules            PolicyRule[]
  fixtures         PolicyTestFixture[]
  activationSignoffs PolicyActivationSignoff[]

  @@index([academicYear, status])
  @@index([status])
  @@map("policy_packs")
}

/// Declarative Regulatory Evaluation Rule within a Policy Pack
model PolicyRule {
  id              String   @id @default(uuid())
  policyPackId    String   @map("policy_pack_id")
  code            String   @map("code") // e.g., "RULE_INTAKE_CEILING", "RULE_STATUTORY_RESERVATION", "RULE_PENAL_NO_ADMISSION"
  name            String
  category        String   // CAPACITY, QUOTA, ELIGIBILITY, TIMELINE, PENAL_ACTION
  clauseReference String   @map("clause_reference") // e.g., "APH 2026-27 Section 2.4", "APH Chapter VII"
  description     String?
  severity        String   @default("VIOLATION") // VIOLATION, WARNING
  parameters      Json     @default("{}") // rule coefficients, statutory percentages, rounding rules
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  policyPack      PolicyPack @relation(fields: [policyPackId], references: [id], onDelete: Cascade)

  @@unique([policyPackId, code])
  @@index([policyPackId])
  @@map("policy_rules")
}

/// Synthetic Test Fixtures for Policy Pack Automated Regression Validation
model PolicyTestFixture {
  id             String    @id @default(uuid())
  policyPackId   String    @map("policy_pack_id")
  name           String
  description    String?
  inputData      Json      @map("input_data") // Synthetic cohort input payload
  expectedOutput Json      @map("expected_output") // Expected evaluation results
  lastRunStatus  String?   @map("last_run_status") // PASSED, FAILED
  lastRunAt      DateTime? @map("last_run_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  policyPack     PolicyPack @relation(fields: [policyPackId], references: [id], onDelete: Cascade)

  @@index([policyPackId])
  @@map("policy_test_fixtures")
}

/// Immutable Dual-Authorization Activation Record
model PolicyActivationSignoff {
  id                        String   @id @default(uuid())
  policyPackId              String   @map("policy_pack_id")
  reviewerId                String   @map("reviewer_id")
  gazetteNotificationNumber String   @map("gazette_notification_number")
  stepUpVerifiedAt          DateTime @map("step_up_verified_at")
  fixtureRunEvidenceHash    String   @map("fixture_run_evidence_hash")
  signoffNotes              String?  @map("signoff_notes")
  activatedAt               DateTime @default(now()) @map("activated_at")

  policyPack                PolicyPack @relation(fields: [policyPackId], references: [id], onDelete: Cascade)
  reviewer                  User       @relation("PolicySignoffReviewer", fields: [reviewerId], references: [id])

  @@index([policyPackId])
  @@index([reviewerId])
  @@map("policy_activation_signoffs")
}
