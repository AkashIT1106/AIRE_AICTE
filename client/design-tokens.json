{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "version": "1.0.0",
  "name": "AIRE Design Tokens",
  "color": {
    "brand": {
      "950": {
        "$value": "#142C3D",
        "$type": "color",
        "description": "Deep ink navy for dark surfaces, footer, strong headings"
      },
      "900": {
        "$value": "#19384E",
        "$type": "color",
        "description": "Institutional navy for header treatments and dark section surfaces"
      },
      "800": {
        "$value": "#24536F",
        "$type": "color",
        "description": "Primary action blue for buttons, links, controls"
      },
      "700": {
        "$value": "#2B6685",
        "$type": "color",
        "description": "Supporting blue for secondary emphasis and illustration details"
      },
      "600": {
        "$value": "#357E9E",
        "$type": "color",
        "description": "Interactive focus and hover accent"
      },
      "100": {
        "$value": "#D6E3EB",
        "$type": "color",
        "description": "Soft brand container boundary"
      },
      "50": {
        "$value": "#EAF1F5",
        "$type": "color",
        "description": "Subtle informational panel and illustration backing"
      }
    },
    "teal": {
      "800": {
        "$value": "#075E58",
        "$type": "color",
        "description": "Deep teal secondary accent for verified/positive emphasis"
      },
      "700": {
        "$value": "#08736A",
        "$type": "color",
        "description": "Supporting teal for icon and accent use"
      },
      "50": {
        "$value": "#E7F2EF",
        "$type": "color",
        "description": "Subdued positive/verification surfaces"
      }
    },
    "brass": {
      "800": {
        "$value": "#8B4F16",
        "$type": "color",
        "description": "Muted warm accent for sparse editorial highlights"
      },
      "50": {
        "$value": "#F6EFE4",
        "$type": "color",
        "description": "Subdued warm editorial surface"
      }
    },
    "neutral": {
      "0": {
        "$value": "#FFFFFF",
        "$type": "color",
        "description": "Pure white for main card and form surfaces"
      },
      "25": {
        "$value": "#FBFCFC",
        "$type": "color",
        "description": "Soft white for subtle section transitions"
      },
      "50": {
        "$value": "#F5F7F7",
        "$type": "color",
        "description": "Default page canvas and public background"
      },
      "100": {
        "$value": "#EEF3F3",
        "$type": "color",
        "description": "Subdued alternate section surface and table headers"
      },
      "150": {
        "$value": "#E7ECEE",
        "$type": "color",
        "description": "Subtle section dividers and horizontal rules"
      },
      "200": {
        "$value": "#D8E0E3",
        "$type": "color",
        "description": "Default border for inputs, cards, and tables"
      },
      "300": {
        "$value": "#AAB7BE",
        "$type": "color",
        "description": "Strong structural border used sparingly"
      },
      "600": {
        "$value": "#536474",
        "$type": "color",
        "description": "Secondary helper and metadata text"
      },
      "800": {
        "$value": "#1D2935",
        "$type": "color",
        "description": "Primary high-contrast body and heading text"
      }
    },
    "state": {
      "success": {
        "text": { "$value": "#176B45", "$type": "color" },
        "bg": { "$value": "#E7F2EC", "$type": "color" },
        "border": { "$value": "#B7DEC8", "$type": "color" }
      },
      "warning": {
        "text": { "$value": "#8A4D0A", "$type": "color" },
        "bg": { "$value": "#F8F0E5", "$type": "color" },
        "border": { "$value": "#F2D8B3", "$type": "color" }
      },
      "error": {
        "text": { "$value": "#B42318", "$type": "color" },
        "bg": { "$value": "#FCEDEB", "$type": "color" },
        "border": { "$value": "#F9C3BE", "$type": "color" }
      },
      "info": {
        "text": { "$value": "#245B78", "$type": "color" },
        "bg": { "$value": "#EAF1F5", "$type": "color" },
        "border": { "$value": "#BDD5E1", "$type": "color" }
      },
      "pending": {
        "text": { "$value": "#536474", "$type": "color" },
        "bg": { "$value": "#EEF3F3", "$type": "color" },
        "border": { "$value": "#D8E0E3", "$type": "color" }
      }
    }
  },
  "spacing": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "20px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" },
    "20": { "$value": "80px", "$type": "dimension" },
    "24": { "$value": "96px", "$type": "dimension" },
    "30": { "$value": "120px", "$type": "dimension" }
  },
  "radius": {
    "control": {
      "$value": "6px",
      "$type": "dimension",
      "description": "Small controls, buttons, form inputs"
    },
    "card": {
      "$value": "10px",
      "$type": "dimension",
      "description": "Standard cards and information surfaces"
    },
    "feature": {
      "$value": "16px",
      "$type": "dimension",
      "description": "Large hero containers and featured surfaces"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension",
      "description": "Status pills and compact badges"
    }
  },
  "typography": {
    "fontFamily": {
      "base": {
        "$value": "\"Noto Sans\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
        "$type": "fontFamily"
      }
    },
    "scale": {
      "display": {
        "fontSize": "52px",
        "lineHeight": "1.12",
        "fontWeight": "600"
      },
      "h1": { "fontSize": "36px", "lineHeight": "1.15", "fontWeight": "600" },
      "h2": { "fontSize": "28px", "lineHeight": "1.2", "fontWeight": "600" },
      "h3": { "fontSize": "22px", "lineHeight": "1.25", "fontWeight": "600" },
      "h4": { "fontSize": "18px", "lineHeight": "1.35", "fontWeight": "600" },
      "body-lg": {
        "fontSize": "18px",
        "lineHeight": "1.6",
        "fontWeight": "400"
      },
      "body": { "fontSize": "16px", "lineHeight": "1.6", "fontWeight": "400" },
      "body-sm": {
        "fontSize": "14px",
        "lineHeight": "1.5",
        "fontWeight": "400"
      },
      "label": { "fontSize": "14px", "lineHeight": "1.4", "fontWeight": "500" },
      "meta": { "fontSize": "12px", "lineHeight": "1.45", "fontWeight": "500" }
    }
  }
}
